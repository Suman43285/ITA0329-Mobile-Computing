serving = [70, 68, 65, 62, 58, 55, 50]
neighbor = [45, 50, 55, 58, 62, 65, 70]

hysteresis = 5
current_cell = "Cell A"

print("Handoff Simulation\n")

for i in range(len(serving)):
    print("Time", i + 1)
    print("Cell A Signal:", serving[i])
    print("Cell B Signal:", neighbor[i])

    if current_cell == "Cell A":
        if neighbor[i] > serving[i] + hysteresis:
            current_cell = "Cell B"
            print("Handoff: Cell A -> Cell B")
        else:
            print("No Handoff")
    else:
        if serving[i] > neighbor[i] + hysteresis:
            current_cell = "Cell A"
            print("Handoff: Cell B -> Cell A")
        else:
            print("No Handoff")

    print("Connected to:", current_cell)
    print()
