import math

i = int(input("Enter i value: "))
j = int(input("Enter j value: "))
channels = int(input("Enter total number of channels: "))
n_interference = int(input("Enter number of interfering cells: "))

N = i * i + i * j + j * j

reuse_ratio = math.sqrt(3 * N)

capacity = channels / N

si = (math.sqrt(3 * N) ** 4) / n_interference
si_db = 10 * math.log10(si)

print("\nCluster Size N =", N)
print("Frequency Reuse Ratio D/R =", round(reuse_ratio, 2))
print("Channels per Cell =", round(capacity, 2))
print("S/I Ratio =", round(si, 2))
print("S/I in dB =", round(si_db, 2), "dB")
