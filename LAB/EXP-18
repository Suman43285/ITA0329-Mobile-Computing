traffic = float(input("Enter traffic intensity (Erlangs): "))
channels = int(input("Enter number of channels: "))

blocking = 1.0

for n in range(1, channels + 1):
    blocking = (traffic * blocking) / (n + traffic * blocking)

print("\nCall Blocking Probability =", round(blocking, 6))
print("Blocking Percentage =", round(blocking * 100, 2), "%")
