def erlang_b(E, C):
    """Blocking probability for offered load E (erlang) and C channels."""
    b = 1.0

    for m in range(1, C + 1):
        b = E * b / (m + E * b)

    return b

def channels_needed(E, gos):
    C = 1

    while erlang_b(E, C) > gos:
        C += 1

    return C
def max_load(C, gos, hi=500.0):
    lo = 0.0

    for _ in range(60):
        mid = (lo + hi) / 2

        if erlang_b(mid, C) < gos:
            lo = mid
        else:
            hi = mid

    return lo

