import math

f = float(input("Enter frequency in MHz: "))
d = float(input("Enter distance in km: "))
pt = float(input("Enter transmitted power in dBm: "))

fspl = 32.44 + 20 * math.log10(f) + 20 * math.log10(d)
pr = pt - fspl

print("\nFree-Space Path Loss =", round(fspl, 2), "dB")
print("Received Power =", round(pr, 2), "dBm")
